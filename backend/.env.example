# Sao chép file này thành backend/.env rồi điền giá trị thật. KHÔNG commit .env.

# Bỏ trống thì server chạy ở cổng 3000.
PORT=3000

# --- MySQL (bắt buộc) ---
# Prisma CLI (migrate, seed) đọc DATABASE_URL.
# Mật khẩu có ký tự đặc biệt (@ # : / ...) phải mã hoá URL, ví dụ @ -> %40.
DATABASE_URL="mysql://root:MAT_KHAU@localhost:3306/recipe_finder"

# PrismaService và prisma/seed.ts đọc nhóm biến này (phải khớp với DATABASE_URL).
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=MAT_KHAU
DATABASE_NAME=recipe_finder

# --- Xác thực: đăng nhập, quên mật khẩu ---
# JWT_SECRET bắt buộc. Thiếu RESET_TOKEN_SECRET thì bước đặt lại mật khẩu báo lỗi.
JWT_SECRET=doi_thanh_chuoi_ngau_nhien_it_nhat_32_ky_tu
JWT_EXPIRES_IN=30d
RESET_TOKEN_SECRET=doi_thanh_chuoi_ngau_nhien_khac

# --- Spoonacular (nguồn công thức mở rộng + dinh dưỡng dự phòng) ---
# Bỏ trống thì chỉ tìm trong công thức nội bộ.
# Đăng ký key miễn phí tại https://spoonacular.com/food-api/console
SPOONACULAR_API_KEY=

# --- Email gửi mã OTP quên mật khẩu (Brevo) ---
# Bỏ trống BREVO_API_KEY hoặc MAIL_FROM_EMAIL thì không gửi email: mã OTP được
# in ra log của server (đủ dùng khi chạy thử trên máy).
# Lấy API key tại https://app.brevo.com/settings/keys/api; MAIL_FROM_EMAIL phải
# là địa chỉ người gửi đã xác minh trên Brevo.
BREVO_API_KEY=
MAIL_FROM_NAME=Recipe Finder
MAIL_FROM_EMAIL=

# --- Cloudinary (upload ảnh món ăn) ---
# Thiếu một trong ba biến thì POST /media/images trả 503; công thức vẫn lưu
# được nhưng không có ảnh. Lấy cả ba giá trị ở trang Dashboard của Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
