# Sao chép file này thành backend/.env rồi điền giá trị thật. KHÔNG commit .env.

PORT=3000

# --- MySQL ---
# Prisma CLI (migrate, seed) đọc DATABASE_URL.
# Mật khẩu có ký tự đặc biệt (@ # : / ...) phải mã hoá URL, ví dụ @ -> %40.
DATABASE_URL="mysql://root:MAT_KHAU@localhost:3306/recipe_finder"

# PrismaService và prisma/seed.ts đọc nhóm biến này (phải khớp với DATABASE_URL).
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=MAT_KHAU
DATABASE_NAME=recipe_finder

# --- Xác thực (UC-01..UC-04, UC-30) ---
JWT_SECRET=doi_thanh_chuoi_ngau_nhien_it_nhat_32_ky_tu
JWT_EXPIRES_IN=30d
RESET_TOKEN_SECRET=doi_thanh_chuoi_ngau_nhien_khac

# --- Spoonacular (nguồn công thức mở rộng) ---
# Đăng ký key miễn phí tại https://spoonacular.com/food-api/console
SPOONACULAR_API_KEY=

# --- Email gửi OTP (UC-30) ---
# Ví dụ Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASS là App Password 16 ký tự.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
